{
  "info": {
    "name": "PBJ-2 Lab 3 Hospital Triage API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Deploy BPMN & DMN",
      "request": {
        "method": "POST",
        "url": "http://localhost:8096/workflow/deploy"
      }
    },
    {
      "name": "2. Start Process - Routine Patient",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patientRef\": \"SYN-PAT-001\",\n  \"appointmentPreference\": \"MORNING\",\n  \"symptomsSummary\": \"Mild headache\",\n  \"chestPain\": false,\n  \"breathingDifficulty\": false,\n  \"feverDays\": 0,\n  \"painScore\": 2\n}"
        },
        "url": "http://localhost:8096/workflow/start"
      }
    },
    {
      "name": "3. Query Slots",
      "request": {
        "method": "GET",
        "url": "http://localhost:8090/scheduling/slots?preference=MORNING"
      }
    }
  ]
}
